  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Launching agent.py for training",
      "type": "debugpy",
      "request": "launch",
      "program": "./src/agent.py",
      "console": "integratedTerminal",
      "args": "flappybird0 --train"
    }
  ]
}
